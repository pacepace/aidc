# Editor / OS
.DS_Store
*.swp
*.swo
.vscode/
.idea/

# Build artifacts
/build/
/dist/
*.tmp
*.bak
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Prawduct plugin artifacts (governance files written locally, not committed)
# Prawduct's own state: the session files below are ignored individually (see the
# "Prawduct session files" block); the product-owned ones — project-state.yaml,
# backlog.md, change-log.md, learnings.md and artifacts/ — are committed.

# aidc runtime artifacts
/proxy/squid/blocklist.txt          # generated by refresher
/proxy/squid/state-actor-tlds.txt   # generated from config OR shipped, see task-03

# Local dev
.env
.env.local

# Local Claude Code overrides (machine-specific; may hold overlay/interface IPs
# or personal plugin choices — opt in locally, don't ship to every cloner)
.claude/settings.local.json

# Test scratch space (smoke tests + manual probes use this for repo mounts
# and audit dirs — keeps everything in-repo, no user-home pollution)
/tests/scratch/*
!/tests/scratch/.gitkeep

# local test scratch (per-project, never committed)
mcp/tests/scratch/

# Prawduct session files
.prawduct/.critic-active
.prawduct/.critic-findings.json
.prawduct/.critic-partials/
.prawduct/.critic-partials-archive/
.prawduct/.delegate-brief.md
.prawduct/.governance-ledger.jsonl
.prawduct/.handoff-notes.md
.prawduct/.test-evidence.json
.prawduct/.pr-reviews/
.prawduct/.session-base-tree
.prawduct/.session-git-baseline
.prawduct/.session-handoff.md
.prawduct/.session-reflected
.prawduct/.session-start
.prawduct/.subagent-briefing.md
.prawduct/.gates-waived
.prawduct/.advisories.json
.prawduct/.work-model-index.json
.prawduct/reflections.md

# Prawduct plugin version marker (per-repo last-seen)
.prawduct/.prawduct-version
