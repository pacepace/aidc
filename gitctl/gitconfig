# /etc/gitconfig in the git container (root-owned): the agent's own git. The agent (uid 2000)
# runs git as itself, with no credential, so this only protects the agent: no repo hooks or
# fsmonitor, no transport that runs a command. gitctl's git (as gitrun) reads no system config.
[core]
	hooksPath = /dev/null
	fsmonitor = false
[protocol "ext"]
	allow = never
[commit]
	gpgSign = false
[tag]
	gpgSign = false
[init]
	defaultBranch = main
# The repos belong to the git container's gitrun user, with their config locked; the agent,
# which holds nothing, reads them as they are.
[safe]
	directory = *
# The author and committer: the user's own name and email, written by the login step as
# gitcred (a later chunk). Commits show as the user; nothing is signed. A missing file is
# skipped.
[include]
	path = /var/lib/gitctl/gitcred/git-identity
