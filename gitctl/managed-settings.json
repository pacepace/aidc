{
  "allowManagedHooksOnly": true,
  "disableBypassPermissionsMode": "disable",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(gitctl *)",
      "Bash(git-requests *)",
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(gh *)",
      "Bash(cd *)",
      "Read",
      "Grep",
      "Glob",
      "AskUserQuestion",
      "Write(//tmp/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "/opt/aidc/lib/gitctl/claude-hook.sh" }
        ]
      }
    ],
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "/usr/local/bin/aidc-hook-event" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "/usr/local/bin/aidc-hook-event" }] }],
    "Notification": [{ "hooks": [{ "type": "command", "command": "/usr/local/bin/aidc-hook-event" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "/usr/local/bin/aidc-hook-event" }] }],
    "StopFailure": [{ "matcher": "rate_limit", "hooks": [{ "type": "command", "command": "/usr/local/bin/aidc-claude-usage rate-limited" }] }]
  }
}
