{
  "allowManagedHooksOnly": true,
  "disableBypassPermissionsMode": "disable",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(gitctl *)",
      "Bash(git-requests *)",
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(gh *)",
      "Bash(cd *)",
      "Read",
      "Grep",
      "Glob",
      "AskUserQuestion",
      "Write(//tmp/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "/opt/aidc/lib/gitctl/claude-hook.sh" }
        ]
      }
    ]
  }
}
