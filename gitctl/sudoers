# /etc/sudoers.d/aidc-gitctl in the git container (root-owned, 0440).
#
# The agent's user (git) holds no secret. The one thing it may run as another user is gitctl,
# whose verbs build their own git and gh command lines (as gitrun: fetch, push; as gitcred: the
# pull requests and the login) and re-check every argument as that user. gitrun gets the
# GitHub token only from the credential helper, as gitcred. env_reset (sudo's default, stated
# here) drops everything the caller exported.
# On Docker, the agent's verbs that write a working copy run as gitwc (the user's uid there), only on
# a working copy Docker mounted (gitctl checks the mount list as gitwc), and
# from it reach gitrun and gitcred as the agent does; gitctl refuses gitwc anywhere else, and
# every verb but fetch, tidy and unpushed.
# gitcred asks gitrun one thing: whether the user added a repo (has-copy, read only). It checks
# that itself before any gh call that names a repo, so a caller who reaches gitcred directly
# cannot act on a repo the user did not add. "Added" is the user's list (aidc repo add, from the
# laptop), mounted read-only at /etc/aidc/git-repos: the agent and gitwc can reach gitrun's
# add-copy (as gitctl clone and adopt do), but gitrun makes a copy of, and has-copy answers yes
# for, only a repo on that list.
Defaults:git,gitrun,gitcred,gitwc env_reset, !lecture, !use_pty
Defaults:git,gitrun,gitcred,gitwc secure_path="/usr/bin:/bin"
git     ALL=(gitrun,gitcred,gitwc) NOPASSWD: /opt/aidc/lib/gitctl/gitctl.sh
gitwc   ALL=(gitrun,gitcred)       NOPASSWD: /opt/aidc/lib/gitctl/gitctl.sh
gitrun  ALL=(gitcred)              NOPASSWD: /opt/aidc/lib/gitctl/cred-helper.sh
gitcred ALL=(gitrun)               NOPASSWD: /opt/aidc/lib/gitctl/gitctl.sh has-copy *
