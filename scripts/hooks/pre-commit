#!/usr/bin/env bash
# pre-commit: refuse a commit whose staged changes name something private (aidc is public).
#
# The patterns are a maintainer's own, kept OUTSIDE the repo, one extended regular expression a
# line (case-insensitive; blank lines and lines starting with # are skipped):
#
#   ${AIDC_PRIVATE_NAMES:-~/.config/aidc/private-names}
#
# The list is never committed: it would publish what it guards. Without it the hook says so
# and lets the commit through; with a line in it that is not a valid pattern, it refuses.
# Install for this clone: git config core.hooksPath scripts/hooks
set -u

list="${AIDC_PRIVATE_NAMES:-${HOME}/.config/aidc/private-names}"
if [ ! -r "$list" ]; then
    printf 'pre-commit: no private-names list at %s: names not checked\n' "$list" >&2
    exit 0
fi

patterns=$(grep -v -e '^[[:space:]]*$' -e '^[[:space:]]*#' "$list")
[ -n "$patterns" ] || exit 0

# Only what this commit adds: the staged diff's added lines, and the names of added files.
added=$( { git diff --cached --no-color -U0 --diff-filter=ACMR | grep -E '^\+' | grep -vE '^\+\+\+ '
           git diff --cached --name-only --diff-filter=ACMR; } 2>/dev/null)
# grep: 0 a match, 1 none, 2 an error (a pattern on the list that is not a valid regular
# expression makes it match nothing at all): an error refuses the commit, never passes it
# unchecked. Its own message is not shown, so no part of the list is printed.
rc=0
hits=$(printf '%s\n' "$added" | grep -i -n -E -f <(printf '%s\n' "$patterns") 2>/dev/null) || rc=$?
if [ "$rc" -gt 1 ]; then
    printf 'pre-commit: the private-names list (%s) has a line that is not a valid extended regular expression, so nothing was checked: fix that line (grep -E -f on the list says which), then commit again\n' "$list" >&2
    exit 1
fi
if [ -n "$hits" ]; then
    printf 'pre-commit: the staged changes name something on your private-names list (%s):\n' "$list" >&2
    # The matching lines, not the patterns: the list itself is never printed.
    printf '%s\n' "$hits" | cut -c1-200 | sed 's/^/  /' >&2
    printf 'Replace them with a generic word, or commit with --no-verify if this is a false match.\n' >&2
    exit 1
fi
exit 0
